rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules have no lambdas, so the players list (at most four) is checked
    // by index.
    function isPlayerIn(players) {
      return (players.size() > 0 && players[0].oddserId == request.auth.uid)
          || (players.size() > 1 && players[1].oddserId == request.auth.uid)
          || (players.size() > 2 && players[2].oddserId == request.auth.uid)
          || (players.size() > 3 && players[3].oddserId == request.auth.uid);
    }

    // Games created since playerIds was added carry it; older games only
    // have the players list.
    function isGamePlayer(game) {
      return request.auth.uid in game.get('playerIds', [])
          || isPlayerIn(game.players);
    }

    function isInvitationParty(invitation) {
      return invitation.fromUserId == request.auth.uid
          || invitation.toUserId == request.auth.uid;
    }

    function isFriendshipParty(friendship) {
      return friendship.user1Id == request.auth.uid
          || friendship.user2Id == request.auth.uid;
    }

    // ========== USER PROFILES ==========

    match /users/{userId} {
      // Any signed-in user reads profiles (friend search, opponents,
      // leaderboard), so a profile must not hold private data such as an
      // e-mail address.
      allow read: if isAuthenticated();

      // Users can only write their own profile
      allow create, update, delete: if isOwner(userId);

      // Cloud wallet and power-up inventory
      match /data/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ========== ONLINE GAMES ==========

    match /games/{gameId} {
      // Players can read games they're in
      allow read: if isAuthenticated() &&
        (resource == null || isGamePlayer(resource.data));

      // Only allow create if user is in players list
      allow create: if isAuthenticated() &&
        isPlayerIn(request.resource.data.players);

      // Players can update game state (moves, scores)
      // In production, this should be server-side only via Cloud Functions
      allow update: if isAuthenticated() &&
        isGamePlayer(resource.data) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

      // Don't allow delete (games are historical records)
      allow delete: if false;
    }

    // ========== MATCHMAKING QUEUE ==========

    match /matchmaking/{queueId} {
      // Anyone authenticated can read queue (for finding matches)
      allow read: if isAuthenticated();

      // Users can create their own queue entry
      allow create: if isAuthenticated() &&
        request.resource.data.oddserId == request.auth.uid;

      // The owner, or the player who matched this entry: findMatch marks both
      // entries in one transaction and later adds the game ID to both.
      allow update: if isAuthenticated() && (
        resource.data.oddserId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'matchedOpponentId', 'matchedGameId']) &&
          request.resource.data.get('matchedOpponentId', '') == request.auth.uid));

      // The owner, or any player cleaning up an expired entry
      allow delete: if isAuthenticated() && (
        resource.data.oddserId == request.auth.uid ||
        resource.data.expiresAt < request.time);
    }

    // ========== GAME INVITATIONS ==========

    match /invitations/{invitationId} {
      // Sender and recipient can read; a deleted invitation reads as missing
      allow read: if isAuthenticated() &&
        (resource == null || isInvitationParty(resource.data));

      // Anyone can create invitation (to send to others)
      allow create: if isAuthenticated() &&
        request.resource.data.fromUserId == request.auth.uid;

      // Both parties can update (accept/decline/cancel)
      allow update: if isAuthenticated() && isInvitationParty(resource.data);

      // Both parties can delete, so account deletion removes invitations
      // in either direction
      allow delete: if isAuthenticated() && isInvitationParty(resource.data);
    }

    // ========== FRIENDSHIPS ==========

    match /friendships/{friendshipId} {
      // Both users can read
      allow read: if isAuthenticated() && isFriendshipParty(resource.data);

      // The requester sends a friend request that includes themselves
      allow create: if isAuthenticated() &&
        request.resource.data.requestedBy == request.auth.uid &&
        isFriendshipParty(request.resource.data);

      // Both users can update (accept/decline/block)
      allow update: if isAuthenticated() && isFriendshipParty(resource.data);

      // Both users can delete (unfriend, account deletion)
      allow delete: if isAuthenticated() && isFriendshipParty(resource.data);
    }

    // ========== LEADERBOARDS (Existing) ==========

    match /leaderboards/{leaderboardId} {
      allow read: if isAuthenticated();

      match /entries/{entryId} {
        allow read: if isAuthenticated();

        // A score belongs to the user who submits it
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;

        // The owner can delete their scores (account deletion)
        allow delete: if isAuthenticated() &&
          resource.data.userId == request.auth.uid;
      }
    }

    // ========== RANKINGS ==========

    match /rankings/{period} {
      allow read: if isAuthenticated();

      match /entries/{userId} {
        allow read: if isAuthenticated();
        // Only server (Cloud Functions) can write rankings
        allow write: if false;
      }
    }
  }
}
